FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN apk add --no-cache font-noto-cjk

COPY backend/gateway-service/target/*.jar ./gateway.jar
COPY backend/auth-service/target/*.jar ./auth.jar
COPY backend/user-service/target/*.jar ./user.jar
COPY backend/course-service/target/*.jar ./course.jar
COPY backend/file-service/target/*.jar ./file.jar
COPY backend/grading-service/target/*.jar ./grading.jar
COPY backend/ocr-service/target/*.jar ./ocr.jar
COPY backend/notification-service/target/*.jar ./notification.jar
COPY backend/similarity-service/target/*.jar ./similarity.jar
COPY backend/admin-service/target/*.jar ./admin.jar
COPY backend/analytics-service/target/*.jar ./analytics.jar

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java -jar gateway.jar & java -jar auth.jar & java -jar user.jar & java -jar course.jar & java -jar file.jar & java -jar grading.jar & java -jar ocr.jar & java -jar notification.jar & java -jar similarity.jar & java -jar admin.jar & java -jar analytics.jar & wait"]
