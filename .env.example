# TrainMark AI local development example

# Web
VITE_APP_NAME=TrainMark AI
VITE_API_BASE_URL=http://localhost:8080
# mock keeps the frontend fully local; http reads gateway APIs and falls back to mock per request.
VITE_API_MODE=mock

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=trainmark_ai
POSTGRES_USER=trainmark
POSTGRES_PASSWORD=trainmark_dev
TRAINMARK_AUTH_STORE=memory
TRAINMARK_AUTH_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_AUTH_JDBC_USERNAME=trainmark
TRAINMARK_AUTH_JDBC_PASSWORD=trainmark_dev
TRAINMARK_USER_STORE=memory
TRAINMARK_USER_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_USER_JDBC_USERNAME=trainmark
TRAINMARK_USER_JDBC_PASSWORD=trainmark_dev
TRAINMARK_COURSE_STORE=memory
TRAINMARK_COURSE_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_COURSE_JDBC_USERNAME=trainmark
TRAINMARK_COURSE_JDBC_PASSWORD=trainmark_dev
TRAINMARK_FILE_STORE=memory
TRAINMARK_FILE_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_FILE_JDBC_USERNAME=trainmark
TRAINMARK_FILE_JDBC_PASSWORD=trainmark_dev
TRAINMARK_NOTIFICATION_STORE=memory
TRAINMARK_NOTIFICATION_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_NOTIFICATION_JDBC_USERNAME=trainmark
TRAINMARK_NOTIFICATION_JDBC_PASSWORD=trainmark_dev
TRAINMARK_SIMILARITY_STORE=memory
TRAINMARK_SIMILARITY_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_SIMILARITY_JDBC_USERNAME=trainmark
TRAINMARK_SIMILARITY_JDBC_PASSWORD=trainmark_dev
TRAINMARK_ANALYTICS_STORE=memory
TRAINMARK_ANALYTICS_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_ANALYTICS_JDBC_USERNAME=trainmark
TRAINMARK_ANALYTICS_JDBC_PASSWORD=trainmark_dev
TRAINMARK_ADMIN_STORE=memory
TRAINMARK_ADMIN_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_ADMIN_JDBC_USERNAME=trainmark
TRAINMARK_ADMIN_JDBC_PASSWORD=trainmark_dev
TRAINMARK_OCR_STORE=memory
TRAINMARK_OCR_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_OCR_JDBC_USERNAME=trainmark
TRAINMARK_OCR_JDBC_PASSWORD=trainmark_dev
TRAINMARK_GRADING_RUBRIC_STORE=memory
TRAINMARK_GRADING_EXPORT_STORE=memory
TRAINMARK_GRADING_PUBLICATION_AUDIT_STORE=memory
TRAINMARK_GRADING_APPEAL_STORE=memory
TRAINMARK_GRADING_JOB_STORE=memory
TRAINMARK_GRADING_RESULT_STORE=memory
TRAINMARK_GRADING_JDBC_URL=jdbc:postgresql://localhost:55432/trainmark_ai
TRAINMARK_GRADING_JDBC_USERNAME=trainmark
TRAINMARK_GRADING_JDBC_PASSWORD=trainmark_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=trainmark
RABBITMQ_PASSWORD=trainmark_dev

# MinIO / S3-compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=trainmark
MINIO_SECRET_KEY=trainmark_dev_password
MINIO_BUCKET=trainmark-reports
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg
UPLOAD_OBJECT_ROOT=.data/uploads
UPLOAD_REQUIRE_OBJECT_CONTENT=false

# AI/OCR integration placeholders
DOCUMENT_PREPROCESSOR_PROVIDER=local
# When DOCUMENT_PREPROCESSOR_PROVIDER=command, placeholders are replaced by ocr-service:
# {submissionId}, {objectKey}
DOCUMENT_PREPROCESSOR_COMMAND=python3 ai/document/local_converter.py --submission-id {submissionId} --object-key {objectKey}
DOCUMENT_PREPROCESSOR_TIMEOUT_SECONDS=60
OCR_PROVIDER=local
# Supported values: local, command, paddleocr.
# When OCR_PROVIDER=command or OCR_PROVIDER=paddleocr with OCR_COMMAND override,
# placeholders are replaced by ocr-service:
# {jobId}, {submissionId}, {objectKey}, {normalizedObjectKey}, {sourceFormat}, {targetFormat}, {pageCount}
OCR_COMMAND=python3 ai/ocr/local_provider.py --job-id {jobId} --submission-id {submissionId} --object-key {objectKey}
OCR_TIMEOUT_SECONDS=60
SCORING_PROVIDER=local
# Supported values: local, command, semantic.
SCORING_COMMAND=python3 ai/scoring/local_provider.py --result-id {resultId} --assignment-id {assignmentId} --submission-id {submissionId} --student-id {studentId} --student-name {studentName} --student-no {studentNo} --file-name {fileName}
SCORING_TIMEOUT_SECONDS=90
ANNOTATION_PROVIDER=local
ANNOTATION_COMMAND=python3 ai/annotation/local_provider.py --result-id {resultId} --submission-id {submissionId} --student-name {studentName} --output-dir {outputDir} --comment {comment}
ANNOTATION_OUTPUT_DIR=/tmp/trainmark-annotations
ANNOTATION_TIMEOUT_SECONDS=60
LLM_PROVIDER=mock
