{
  "name": "trainmark-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter trainmark-ai-web dev",
    "build:web": "pnpm --filter trainmark-ai-web build",
    "lint:web": "pnpm --filter trainmark-ai-web lint",
    "verify:mvp": "bash scripts/verify-mvp.sh",
    "verify:ai": "bash scripts/verify-ai.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "smoke:api": "bash scripts/smoke-api.sh",
    "smoke:auth:strict": "bash scripts/smoke-auth-strict.sh",
    "smoke:mvp:jdbc": "TRAINMARK_MVP_SMOKE_ONLY=1 TRAINMARK_STRICT_AUTH_SMOKE=1 TRAINMARK_JDBC_ASSERTIONS=1 bash scripts/dev-mvp-jdbc.sh",
    "smoke:mvp:minio": "TRAINMARK_MVP_SMOKE_ONLY=1 TRAINMARK_STRICT_AUTH_SMOKE=1 TRAINMARK_JDBC_ASSERTIONS=1 UPLOAD_OBJECT_STORE=minio UPLOAD_REQUIRE_OBJECT_CONTENT=true bash scripts/dev-mvp-jdbc.sh",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "stop:infra": "docker compose -f infra/docker-compose.yml down",
    "db:migrate:local": "bash scripts/apply-db-migrations.sh",
    "dev:mvp": "bash scripts/dev-mvp.sh",
    "dev:mvp:jdbc": "bash scripts/dev-mvp-jdbc.sh",
    "dev:backend": "bash scripts/dev-backend.sh",
    "dev:backend:gateway": "bash scripts/dev-service.sh gateway-service",
    "dev:backend:auth": "bash scripts/dev-service.sh auth-service",
    "dev:backend:user": "bash scripts/dev-service.sh user-service",
    "dev:backend:course": "bash scripts/dev-service.sh course-service",
    "dev:backend:file": "bash scripts/dev-service.sh file-service",
    "dev:backend:grading": "bash scripts/dev-service.sh grading-service",
    "dev:backend:ocr": "bash scripts/dev-service.sh ocr-service",
    "dev:backend:similarity": "bash scripts/dev-service.sh similarity-service",
    "dev:backend:analytics": "bash scripts/dev-service.sh analytics-service",
    "dev:backend:notification": "bash scripts/dev-service.sh notification-service",
    "dev:backend:admin": "bash scripts/dev-service.sh admin-service",
    "build:backend": "mvn -f backend/pom.xml package -DskipTests",
    "deploy:local": "bash scripts/deploy.sh"
  },
  "packageManager": "pnpm@10.17.1"
}
