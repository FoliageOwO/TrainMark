{
  "name": "trainmark-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:web": "pnpm --filter trainmark-ai-web dev",
    "start:backend": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-all.sh",
    "start:stack": "node scripts/lib/run-bash-script.mjs scripts/dev/fullstack-jdbc.sh",
    "start:stack:http": "node scripts/lib/run-bash-script.mjs scripts/dev/fullstack.sh",
    "start:ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-ai-bridge.ps1",
    "start:stack:ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/fullstack-ai.ps1",
    "start:service:gateway": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh gateway-service",
    "start:service:auth": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh auth-service",
    "start:service:user": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh user-service",
    "start:service:course": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh course-service",
    "start:service:file": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh file-service",
    "start:service:grading": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh grading-service",
    "start:service:ocr": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh ocr-service",
    "start:service:similarity": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh similarity-service",
    "start:service:analytics": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh analytics-service",
    "start:service:notification": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh notification-service",
    "start:service:admin": "node scripts/lib/run-bash-script.mjs scripts/dev/backend-service.sh admin-service",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:restart": "node scripts/lib/run-bash-script.mjs scripts/dev/infra-restart.sh",
    "infra:reset": "node scripts/lib/run-bash-script.mjs scripts/dev/infra-reset.sh",
    "infra:status": "docker compose -f infra/docker-compose.yml ps",
    "db:migrate:local": "node scripts/lib/run-bash-script.mjs scripts/ops/db-migrate-local.sh",
    "verify:stack": "node scripts/lib/run-bash-script.mjs scripts/verify/check-stack.sh",
    "verify:ai": "node scripts/lib/run-bash-script.mjs scripts/verify/check-ai.sh",
    "smoke:api": "node scripts/lib/run-bash-script.mjs scripts/verify/smoke-api.sh",
    "smoke:auth:strict": "node scripts/lib/run-bash-script.mjs scripts/verify/smoke-auth-strict.sh",
    "smoke:stack": "node scripts/lib/run-bash-script.mjs --env TRAINMARK_MVP_SMOKE_ONLY=1 --env TRAINMARK_STRICT_AUTH_SMOKE=1 --env TRAINMARK_JDBC_ASSERTIONS=1 scripts/dev/fullstack-jdbc.sh",
    "smoke:stack:minio": "node scripts/lib/run-bash-script.mjs --env TRAINMARK_MVP_SMOKE_ONLY=1 --env TRAINMARK_STRICT_AUTH_SMOKE=1 --env TRAINMARK_JDBC_ASSERTIONS=1 --env UPLOAD_OBJECT_STORE=minio --env UPLOAD_REQUIRE_OBJECT_CONTENT=true scripts/dev/fullstack-jdbc.sh",
    "smoke:stack:async": "node scripts/lib/run-bash-script.mjs --env TRAINMARK_MVP_SMOKE_ONLY=1 --env TRAINMARK_STRICT_AUTH_SMOKE=1 --env TRAINMARK_JDBC_ASSERTIONS=1 --env GRADING_ASYNC_ENABLED=true --env OCR_ASYNC_ENABLED=true --env GRADE_EXPORT_ASYNC_ENABLED=true --env NOTIFICATION_ASYNC_ENABLED=true scripts/dev/fullstack-jdbc.sh",
    "build:web": "pnpm --filter trainmark-ai-web build",
    "build:backend": "mvn -f backend/pom.xml package -DskipTests",
    "build:all": "node scripts/lib/run-bash-script.mjs scripts/ops/build-all.sh",
    "lint:web": "pnpm --filter trainmark-ai-web lint",
    "ops:backup:local": "node scripts/lib/run-bash-script.mjs scripts/ops/backup-local.sh",
    "ops:restore:local": "node scripts/lib/run-bash-script.mjs scripts/ops/restore-local.sh",
    "ops:release:local": "node scripts/lib/run-bash-script.mjs scripts/ops/package-local-release.sh",
    "ops:images:export": "node scripts/lib/run-bash-script.mjs scripts/ops/build-images-and-export.sh",
    "ops:deploy:server": "node scripts/lib/run-bash-script.mjs scripts/ops/deploy-server-runtime.sh",
    "ops:start:server": "node scripts/lib/run-bash-script.mjs scripts/ops/start-server-runtime.sh",
    "ops:deploy:remote": "node scripts/lib/run-bash-script.mjs scripts/ops/deploy-remote-all-in-one.sh",
    "dev:web": "pnpm start:web",
    "dev:infra": "pnpm infra:up",
    "stop:infra": "pnpm infra:down",
    "dev:backend": "pnpm start:backend",
    "dev:backend:gateway": "pnpm start:service:gateway",
    "dev:backend:auth": "pnpm start:service:auth",
    "dev:backend:user": "pnpm start:service:user",
    "dev:backend:course": "pnpm start:service:course",
    "dev:backend:file": "pnpm start:service:file",
    "dev:backend:grading": "pnpm start:service:grading",
    "dev:backend:ocr": "pnpm start:service:ocr",
    "dev:backend:similarity": "pnpm start:service:similarity",
    "dev:backend:analytics": "pnpm start:service:analytics",
    "dev:backend:notification": "pnpm start:service:notification",
    "dev:backend:admin": "pnpm start:service:admin",
    "dev:mvp": "pnpm start:stack:http",
    "dev:mvp:jdbc": "pnpm start:stack",
    "verify:mvp": "pnpm verify:stack",
    "backup": "pnpm ops:backup:local",
    "restore": "pnpm ops:restore:local",
    "smoke:mvp:jdbc": "pnpm smoke:stack",
    "smoke:mvp:minio": "pnpm smoke:stack:minio",
    "smoke:mvp:async": "pnpm smoke:stack:async",
    "deploy:local": "pnpm ops:release:local"
  },
  "packageManager": "pnpm@10.17.1"
}
